NODE_ENV=development
PORT=5001
DATABASE_URL=postgresql://user:password@localhost:25432/garagekings
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=2
STORAGE_DRIVER_OVERRIDE=
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_NAME=garagekings-local
DYNAMODB_AUTO_CREATE=true
NODE_EXTRA_CA_CERTS=./certs/ap-south-1-bundle.pem
JWT_SECRET=replace-with-at-least-32-random-characters
OWNER_SETUP_TOKEN=replace-with-a-separate-random-token
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
S3_ASSETS_BUCKET=
S3_PRIVATE_BUCKET=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
